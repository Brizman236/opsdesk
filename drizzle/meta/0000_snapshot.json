        },
        "tickets_description_length_check": {
          "name": "tickets_description_length_check",
          "value": "char_length(\"tickets\".\"description\") BETWEEN 10 AND 5000 AND btrim(\"tickets\".\"description\") <> ''"
        },
        "tickets_status_check": {
          "name": "tickets_status_check",
          "value": "\"tickets\".\"status\" IN ('open', 'in_progress', 'closed')"
        }
